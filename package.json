{
  "name": "styling-agent",
  "private": true,
  "version": "0.1.0",
  "description": "AI styling agent for D2C fashion brands: complete-the-look on site + WhatsApp styling messages",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "migrate": "npm run migrate -w server",
    "import": "npm run import -w server --",
    "enrich": "npm run enrich -w server --",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "test": "npm test -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  },
  "engines": {
    "node": ">=22.9"
  }
}
