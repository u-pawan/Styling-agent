# --- Database -------------------------------------------------------------
# Local (docker compose): postgres://styling:styling@localhost:5433/styling
# Neon: paste the pooled connection string from the Neon console, e.g.
#   postgres://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://styling:styling@localhost:5433/styling

# --- Ollama (local models) -----------------------------------------------
OLLAMA_URL=http://localhost:11434
# Vision + text model used for catalog tagging and styling copy
TAG_MODEL=qwen3-vl:4b-instruct
CHAT_MODEL=qwen3-vl:4b-instruct
# Embedding model + its vector size (nomic-embed-text = 768, bge-m3 = 1024)
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# --- Store being demoed ----------------------------------------------------
STORE_URL=https://www.snitch.co.in
STORE_NAME=Snitch

# --- Server ------------------------------------------------------------------
PORT=4000
PUBLIC_URL=http://localhost:4000
SHOP_URL=http://localhost:5173

# --- WhatsApp Cloud API (leave blank to stay in dry-run / preview mode) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_TEMPLATE=post_purchase_styling
WHATSAPP_TEMPLATE_LANG=en
GRAPH_API_VERSION=v23.0
